{
  "name": "n8n-nodes-pluggy",
  "version": "0.1.0",
  "description": "n8n community node para a API da Pluggy — listagem de transações financeiras",
  "keywords": [
    "n8n-community-node-package",
    "pluggy",
    "finance",
    "transactions",
    "open-finance"
  ],
  "license": "MIT",
  "homepage": "",
  "author": {
    "name": "Henrique Silveira"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/henrysssilveira/n8n-nodes-pluggy"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && npm run copy-icons",
    "copy-icons": "copyfiles -u 1 \"src/**/*.svg\" dist/",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials --ext .ts",
    "lintfix": "eslint nodes credentials --ext .ts --fix"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PluggyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/PluggyTransactions/PluggyTransactions.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "copyfiles": "^2.4.1",
    "typescript": "^5.0.0",
    "n8n-workflow": "*"
  }
}
